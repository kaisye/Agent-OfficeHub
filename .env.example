# Copy to .env — never commit real values
DATABASE_URL=postgres://officehub:officehub@localhost:5433/officehub
API_PORT=8787
MCP_PORT=8788
WEB_ORIGIN=http://localhost:3000
# REQUIRED in production: 32+ random chars (openssl rand -base64 48). The API refuses to start with a default.
SESSION_SECRET=change-me-dev-only
# Optional GitHub login (password login via invite links works without it). Also set NEXT_PUBLIC_GITHUB_LOGIN=1 for the web button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Master secret; each workspace's webhook secret is derived from it (see /w/:slug/connectors/github).
GITHUB_WEBHOOK_SECRET=
# Lets anyone log in as any member. Local development ONLY — set true in your own .env, never in production.
DEV_LOGIN_ENABLED=false
