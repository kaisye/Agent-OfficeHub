{
  "name": "office-hub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm -r --parallel dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @officehub/db migrate",
    "db:seed": "pnpm --filter @officehub/db seed",
    "dev:api": "pnpm --filter @officehub/api dev",
    "dev:mcp": "pnpm --filter @officehub/mcp dev",
    "dev:web": "pnpm --filter @officehub/web dev",
    "e2e": "pnpm --filter @officehub/e2e e2e"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
