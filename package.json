{
  "name": "office-hub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm db:up && pnpm db:migrate && concurrently -k -n api,mcp,web -c blue,magenta,green \"pnpm dev:api\" \"pnpm dev:mcp\" \"pnpm dev:web:http\"",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @officehub/db migrate",
    "db:seed": "pnpm --filter @officehub/db seed",
    "db:invite": "pnpm --filter @officehub/db invite",
    "db:seed:marketing": "pnpm --filter @officehub/db seed:marketing",
    "runner": "pnpm --filter @officehub/agent-runner start",
    "dev:api": "pnpm --filter @officehub/api dev",
    "dev:mcp": "pnpm --filter @officehub/mcp dev",
    "e2e": "pnpm --filter @officehub/e2e e2e",
    "dev:web:http": "NEXT_PUBLIC_API_MODE=http NEXT_PUBLIC_API_URL=http://localhost:8787 pnpm --filter @officehub/web dev",
    "dev:ui": "pnpm --filter @officehub/web dev",
    "dev:web": "pnpm --filter @officehub/web dev"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "typescript": "^5.6.3"
  }
}
