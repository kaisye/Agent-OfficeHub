# mock (default, in-memory, seeded from docs/business/seed-tripflix.json) or http (real API)
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:8787
# The API's /me does not return the workspace slug, so the web app takes it from here.
NEXT_PUBLIC_DEFAULT_WORKSPACE=tripflix
# Show the "Chon thanh vien" dev-login picker (always on outside production builds)
NEXT_PUBLIC_DEV_LOGIN=1
NEXT_PUBLIC_MCP_URL=http://localhost:8788/mcp
